# Copy to .env and fill in. Never commit the real .env.

# Neon gives you a `postgresql://...?sslmode=require&channel_binding=require` URL —
# asyncpg needs the driver prefixed (+asyncpg) and doesn't understand
# channel_binding at all, so rewrite it to this shape:
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-12345.us-east-2.aws.neon.tech/pocketauditor?ssl=require
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
LLM_PROVIDER=ollama   # or "claude"
LLM_MODEL=qwen2.5vl:7b  # or "claude-sonnet-5"
ANTHROPIC_API_KEY=     # only needed when LLM_PROVIDER=claude

# --- optional, sensible defaults shown ---
OLLAMA_BASE_URL=http://localhost:11434
TELEGRAM_WEBHOOK_SECRET=            # random string; leave blank locally, set in prod
CONFIDENCE_THRESHOLD=0.75
CANDIDATE_AMOUNT_TOLERANCE_PCT=0.05
CANDIDATE_DATE_WINDOW_DAYS=2
RUN_MODE=webhook      # "polling" for local dev without a public URL
PORT=7001
