# Copy to .env and fill in. Never commit the real .env.

# Neon gives you a `postgresql://...?sslmode=require&channel_binding=require` URL —
# asyncpg needs the driver prefixed (+asyncpg) and doesn't understand
# channel_binding at all, so rewrite it to this shape:
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-12345.us-east-2.aws.neon.tech/pocketauditor?ssl=require
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
LLM_PROVIDER=ollama   # "ollama" | "claude" | "gemini"
LLM_MODEL=qwen2.5vl:7b  # or "claude-sonnet-5" / "gemini-flash-lite-latest"
ANTHROPIC_API_KEY=     # only needed when LLM_PROVIDER=claude
GEMINI_API_KEY=        # only needed when LLM_PROVIDER=gemini — free, see README

# --- optional, sensible defaults shown ---
OLLAMA_BASE_URL=http://localhost:11434
# Random strings. Leave blank locally (polling mode never calls either route),
# but the webhook/cron routes reject everything — including real Telegram
# updates — until these are set to match, so set both before deploying.
TELEGRAM_WEBHOOK_SECRET=            # must match the secret_token passed to setWebhook
CRON_SECRET=                        # sent by your cron caller as X-Cron-Secret
CONFIDENCE_THRESHOLD=0.75
CANDIDATE_AMOUNT_TOLERANCE_PCT=0.05
CANDIDATE_DATE_WINDOW_DAYS=2
RUN_MODE=webhook      # "polling" for local dev without a public URL
PORT=7001
